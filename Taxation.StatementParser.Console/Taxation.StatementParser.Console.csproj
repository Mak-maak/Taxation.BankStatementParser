<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Taxation.StatementParser.Console</RootNamespace>
    <!-- User-facing executable name (the .Console suffix is a code-only project convention). -->
    <AssemblyName>Bank Statement Parser</AssemblyName>
    <Product>Bank Statement Parser</Product>
    <AssemblyTitle>Bank Statement Parser</AssemblyTitle>
    <!-- Executable icon shown in Explorer, the taskbar and the title bar. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="OpenMcdf" Version="3.3.0" />
    <!-- Fully offline, deep-learning OCR for scanned (image-only) statements. PaddleOCR is far more
         accurate than classic OCR on low-quality scans/photos (dates, amounts, columns). The models
         are bundled locally and inference runs on the CPU via the native runtime — no network access. -->
    <PackageReference Include="Sdcb.PaddleOCR" Version="3.3.1" />
    <PackageReference Include="Sdcb.PaddleOCR.Models.Local" Version="3.3.1" />
    <PackageReference Include="Sdcb.PaddleInference" Version="3.3.1" />
    <PackageReference Include="Sdcb.PaddleInference.runtime.win64.mkl" Version="3.3.1.70" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <!-- Rasterizes image-only PDF pages to bitmaps so they can be OCR'd. -->
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the web UI as an editable file so colours/markup can be tweaked without recompiling. -->
    <None Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Application configuration (Excel password protection, etc.), editable next to the exe. -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Taxation.StatementParser.Console.Tests" />
  </ItemGroup>

</Project>
